# Supabase (projet créé dans votre compte : https://supabase.com/dashboard)
# URL du projet Supabase (Settings -> API -> Project URL)
SUPABASE_URL=https://VOTRE-PROJET.supabase.co

# Clé de service Supabase (Settings -> API -> service_role). NE JAMAIS EXPOSER côté client.
SUPABASE_SERVICE_ROLE_KEY=VOTRE-SERVICE-ROLE-KEY

# Secret de signature des tokens JWT (changez-le par une valeur longue et aléatoire)
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire
